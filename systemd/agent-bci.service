[Unit]
Description=Agent BCI container (docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/kawamura/agent
ExecStart=/usr/bin/docker compose up -d --build bci
ExecStop=/usr/bin/docker compose down
Restart=on-failure

[Install]
WantedBy=multi-user.target
