[Unit]
Description=Agent BCI container (docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/kawamura/agent
# Use explicit compose file path and run in detached mode
ExecStart=/usr/bin/docker compose -f /home/kawamura/agent/docker-compose.yml up -d --build bci
ExecStop=/usr/bin/docker compose -f /home/kawamura/agent/docker-compose.yml down
# Keep enabled across failures; unit is oneshot with RemainAfterExit
Restart=on-failure

[Install]
WantedBy=multi-user.target
